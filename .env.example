# PolicyDiff Environment Configuration Example

PROJECT_NAME=PolicyDiff
API_V1_STR=/api/v1
SECRET_KEY=change-to-a-strong-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Database Connection (SQLite default for local development, PostgreSQL for production)
DATABASE_URL=sqlite:///./policydiff.db
# DATABASE_URL=postgresql://policydiff:policydiff_secret@localhost:5432/policydiff_db

# File Storage Configuration
UPLOAD_MAX_SIZE_MB=50
UPLOAD_DIR=./backend/uploads
